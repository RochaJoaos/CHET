@startuml
title Sistema de Mensagens - Context Diagram (C1)

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' Pessoas
Person(user, "Usuário", "Pessoa que envia e recebe mensagens")

' Sistema principal
System(chatSystem, "Sistema de Mensagens", "Comunicação em tempo real entre usuários")

' Sistemas externos
System_Ext(emailSystem, "Serviço de Email", "Envio de notificações e verificação de conta")
System_Ext(pushSystem, "Serviço de Notificação", "Push notifications")
System_Ext(authProvider, "Provedor de Autenticação", "Login e autenticação (OAuth2)")

' Relacionamentos
Rel(user, chatSystem, "Usa via navegador")

Rel(chatSystem, emailSystem, "Envia emails")
Rel(chatSystem, pushSystem, "Envia notificações")
Rel(chatSystem, authProvider, "Autentica usuários")

@enduml
